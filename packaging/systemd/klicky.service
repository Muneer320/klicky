[Unit]
Description=Low-latency mechanical keyboard sounds
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/klicky start
ExecStop=%h/.local/bin/klicky stop
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=default.target
