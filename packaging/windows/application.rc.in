#include <windows.h>

101 ICON "klicky.ico"
1 RT_MANIFEST "application.manifest"
1 VERSIONINFO
 FILEVERSION @VERSION_NUMBERS@
 PRODUCTVERSION @VERSION_NUMBERS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Klicky keyboard sounds\0"
      VALUE "FileVersion", "@VERSION@.0\0"
      VALUE "InternalName", "@BINARY@\0"
      VALUE "LegalCopyright", "Copyright 2026 Muneer Alam and Sauhard Gupta\0"
      VALUE "OriginalFilename", "@BINARY@.exe\0"
      VALUE "ProductName", "Klicky\0"
      VALUE "ProductVersion", "@VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
