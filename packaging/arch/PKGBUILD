# Maintainer: Muneer Alam <muneer.alam320@gmail.com>
pkgname=klicky
pkgver=0.3.0
pkgrel=1
pkgdesc="Low-latency mechanical keyboard sounds for Linux"
arch=('x86_64')
url="https://github.com/Muneer320/klicky"
license=('MIT')
depends=('alsa-lib' 'gcc-libs' 'glibc' 'systemd')
makedepends=('cargo' 'git')
source=("$pkgname::git+$url.git#tag=v$pkgver")
b2sums=('SKIP')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  cargo build --release --locked
}

check() {
  cd "$pkgname"
  cargo test --locked
}

package() {
  cd "$pkgname"

  install -Dm755 target/release/klicky "$pkgdir/usr/bin/klicky"
  install -Dm644 packaging/systemd/klicky-packaged.service \
    "$pkgdir/usr/lib/systemd/user/klicky.service"
  install -Dm644 packaging/udev/70-klicky.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-klicky.rules"

  install -d "$pkgdir/usr/share/klicky/sounds"
  cp -a sounds/. "$pkgdir/usr/share/klicky/sounds/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/klicky/LICENSE"
  install -Dm644 sounds/LICENSE.md \
    "$pkgdir/usr/share/licenses/klicky/SOUND_RECORDINGS.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/klicky/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/klicky/CHANGELOG.md"
  install -Dm644 docs/klicky.1 "$pkgdir/usr/share/man/man1/klicky.1"
}
